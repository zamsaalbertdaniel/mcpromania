# Gateway environment. Copy to apps/gateway/.env and replace the placeholders.
# The gateway authenticates to Supabase with the anon key only.
# Do not put a service role key in this file.

PORT=4000
REDIS_URL=redis://127.0.0.1:6379
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ANAF_API_URL=https://webservicesp.anaf.ro/api/PlatitorTvaRest/v9/tva
BNR_XML_URL=https://curs.bnr.ro/nbrfxrates.xml
RATE_LIMIT_PER_MINUTE=60
AUTH_CACHE_TTL_SECONDS=300
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000
REQUEST_TIMEOUT_MS=3000
