# ==============================================================================
# MCP ROMÂNIA (mcpromania.ro) - CONFIGURARE VARIABILE DE MEDIU (.env.example)
# ==============================================================================
# Copiați acest fișier ca `.env` și completați valorile cu secretele reale din
# panourile Supabase, Upstash Redis, Coolify, Vercel și furnizorii de servicii.

# ------------------------------------------------------------------------------
# 1. MEDIU ȘI APLICAȚIE (GENERAL)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=https://mcpromania.ro
NEXT_PUBLIC_API_URL=https://api.mcpromania.ro

# ------------------------------------------------------------------------------
# 2. DUAL ARCHITECTURE: MCP SERVER + REST API GATEWAY
# ------------------------------------------------------------------------------
# Portul pe care rulează gateway-ul Hono (MCP Streamable HTTP + REST)
GATEWAY_PORT=4000
# URL-ul public pentru SSE Stream MCP (consumat de Claude Desktop, Cursor, etc.)
MCP_SERVER_PUBLIC_URL=http://localhost:4000/mcp/sse
# Limită globală de rate-limiting (cereri pe minut per tenant / cheie API)
DEFAULT_RATE_LIMIT_PER_MINUTE=120
# Timeout apeluri externe (în milisecunde)
UPSTREAM_HTTP_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
# 3. BAZĂ DE DATE & SUPABASE (MULTI-TENANT & RLS)
# ------------------------------------------------------------------------------
# URL-ul instanței Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Cheia Anon / Publică (folosită pentru clienți securizați RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Cheia Service Role (CRITIC: folosită exclusiv pe server pentru bypass RLS la tenant lookup)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Conexiunea directă la baza de date PostgreSQL (folosită de migrări / Drizzle / Prisma dacă e cazul)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
# Conexiunea prin Supavisor Connection Pooler (recomandat pentru serverless / microservicii)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 4. REDIS & COZI BULLMQ (CACHE, RATE LIMITING, WORKERI ASINCRONI)
# ------------------------------------------------------------------------------
# Conexiune Redis (local sau Upstash / Redis Cloud / Managed Redis)
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379
# Prefix pentru spațiul de chei Redis al MCP România
REDIS_KEY_PREFIX=mcpr:
# Conexiune opțională separată pentru coada BullMQ dacă se dorește izolare
BULLMQ_REDIS_URL=redis://default:your-redis-password@your-redis-host:6379

# ------------------------------------------------------------------------------
# 5. SECURITATE ȘI CRIPTOGRAFIE (AES-256-GCM & CHEI API)
# ------------------------------------------------------------------------------
# Cheie master de 32 bytes în format HEX (exact 64 caractere hex)
# Generare rapidă: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secret pentru semnarea webhook-urilor către clienți (HMAC SHA-256)
WEBHOOK_SIGNING_SECRET=whsec_your_webhook_hmac_secret_here
# Secret pentru generare/validare JWT sesiuni interne
JWT_SECRET=your-super-secret-jwt-signing-key-here

# ------------------------------------------------------------------------------
# 6. CONECTORI SERVICII ȘI DATE PUBLICE ROMÂNIA
# ------------------------------------------------------------------------------
# ANAF (Agenția Națională de Administrare Fiscală)
ANAF_API_BASE_URL=https://api.anaf.ro
ANAF_CLIENT_ID=your_anaf_oauth2_client_id
ANAF_CLIENT_SECRET=your_anaf_oauth2_client_secret
# Certificat digital calificat (pentru e-Factura & SPV - cale fisier .pfx / .p12 sau base64)
ANAF_CERTIFICATE_PATH=/path/to/qualified_cert.pfx
ANAF_CERTIFICATE_PASSWORD=cert_password_if_applicable

# PortalJust (Ministerul Justiției din România)
PORTALJUST_SOAP_ENDPOINT=http://portaljust.ro/ws/v1/query.asmx
PORTALJUST_MAX_CONCURRENT_REQUESTS=3

# BNR (Banca Națională a României)
BNR_XML_URL=https://www.bnr.ro/nbrfxrates.xml

# SEAP / SICAP (Achiziții Publice)
SEAP_API_URL=https://api.e-licitatie.ro
SEAP_API_KEY=your_seap_token_if_registered
SEAP_SYNC_INTERVAL_CRON="0 */2 * * *" # La fiecare 2 ore

# SmartBill / Facturare SaaS
SMARTBILL_API_URL=https://ws.smartbill.ro/SBWSI/rest
SMARTBILL_CIF=RO12345678
SMARTBILL_TOKEN=your_smartbill_api_token
SMARTBILL_USERNAME=billing@mcpromania.ro
SMARTBILL_SERIES_NAME=MCP

# ------------------------------------------------------------------------------
# 7. MONITORIZARE, TELEMETRIE ȘI LOGS
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
AXIOM_TOKEN=
LOG_LEVEL=info
