# ==============================================================================
# MCP ROMÂNIA - Dashboard (Vercel) Environment Variables
# ==============================================================================
# Server-side only (DO NOT prefix with NEXT_PUBLIC_):
WAITLIST_EDGE_URL=https://your-project-id.supabase.co/functions/v1/waitlist-submit
WAITLIST_EDGE_SECRET=replace-with-64-char-random-secret
SUPABASE_ANON_KEY=your-anon-public-key

# Upstash Redis REST API (obligatoriu în producție pentru rate-limit distribuit pe /api/waitlist):
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Public site URL metadata:
NEXT_PUBLIC_APP_URL=https://www.mcpromania.ro
NEXT_PUBLIC_API_URL=https://api.mcpromania.ro
