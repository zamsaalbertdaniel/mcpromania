{
  "name": "mcpromania",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "dev:gateway": "pnpm --filter @mcpromania/gateway dev",
    "build": "turbo run build --filter=@mcpromania/dashboard --filter=@mcpromania/gateway",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0"
  }
}
